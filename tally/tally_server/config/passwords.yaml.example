# Local Serverpod passwords — copy to passwords.yaml (gitignored).
# DO NOT commit real production / Cloud secrets here.
#
# Keep docker-compose defaults in sync:
#   development.database / redis  → tallydevlocaldb / tallydevlocalredis
#   test.database / redis         → tallytestlocaldb / tallytestlocalredis

development:
  database: 'tallydevlocaldb'
  redis: 'tallydevlocalredis'
  # serviceSecret / JWT peppers: generate locally; never commit high-entropy values.

test:
  database: 'tallytestlocaldb'
  redis: 'tallytestlocalredis'
